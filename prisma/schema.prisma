generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENCADRANT
  STAGIAIRE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  TERMINE
}

enum GitProvider {
  GITHUB
  GITLAB
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAGIAIRE)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dateDebutStage    DateTime?
  dateFinStage      DateTime?
  numeroCarteSejour String?  @unique

  encadrantId       String?
  encadrant         User?    @relation("Encadrement", fields: [encadrantId], references: [id])
  stagiaires        User[]   @relation("Encadrement")

  teamMembers    TeamMember[]
  tasks          Task[]        @relation("AssignedTasks")
  ownedProjects  Project[]     @relation("Owner")
  livrables      Livrable[]
  messages       Message[]
  scores         Score[]
  alerts         Alert[]

  // Compétition
  badges         UserBadge[]
  defis          DefiParticipation[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  status       String   @default("ACTIF")
  summaryIA    String?
  scoreActivite Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId      String
  owner        User     @relation("Owner", fields: [ownerId], references: [id])

  teams        Team[]
  tasks        Task[]
  gitRepos     GitRepository[]
  livrables    Livrable[]
  alerts       Alert[]
  scores       Score[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  members   TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus @default(A_FAIRE)
  assignedToId String?
  projectId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  project      Project    @relation(fields: [projectId], references: [id])
}

model GitRepository {
  id        String      @id @default(cuid())
  url       String
  provider  GitProvider
  repoId    String
  name      String
  lastSync  DateTime?
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])

  commits   GitCommit[]
}

model GitCommit {
  id               String   @id @default(cuid())
  message          String
  authorName       String
  authorEmail      String
  commitDate       DateTime
  sha              String   @unique
  semanticCategory String?
  summaryIA        String?
  repoId           String
  repository       GitRepository @relation(fields: [repoId], references: [id])
}

model Livrable {
  id           String   @id @default(cuid())
  filename     String
  filepath     String
  indexedText  String?
  uploadedById String
  projectId    String
  createdAt    DateTime @default(now())

  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  conversationId String
  senderId       String
  iaSummary      String?
  createdAt      DateTime @default(now())

  sender         User     @relation(fields: [senderId], references: [id])
}

model Alert {
  id        String   @id @default(cuid())
  type      String
  message   String
  resolved  Boolean  @default(false)
  projectId String
  userId    String?
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Score {
  id        String   @id @default(cuid())
  value     Float
  date      DateTime @default(now())
  userId    String
  projectId String

  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId, date])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  xpReward    Int
  createdAt   DateTime @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Defi {
  id          String   @id @default(cuid())
  title       String
  description String
  xpReward    Int
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)

  participations DefiParticipation[]
}

model DefiParticipation {
  id        String   @id @default(cuid())
  userId    String
  defiId    String
  completed Boolean  @default(false)
  completedAt DateTime?

  user      User     @relation(fields: [userId], references: [id])
  defi      Defi     @relation(fields: [defiId], references: [id])
}